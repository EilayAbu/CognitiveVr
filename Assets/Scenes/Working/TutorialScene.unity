    completeInstruction: "\u05DB\u05DC \u05D4\u05DB\u05D1\u05D5\u05D3, \u05E9\u05D9\u05DE\u05D5
      \u05DC\u05D1, \u05D4\u05E9\u05E2\u05D5\u05DF \u05D9\u05DC\u05D5\u05D5\u05D4
      \u05D0\u05D5\u05EA\u05DB\u05DD \u05D1\u05DE\u05D4\u05DC\u05DA \u05DB\u05DC
      \u05D4\u05E1\u05D9\u05DE\u05D5\u05DC\u05E6\u05D9\u05D4."
    completeVoiceClip: {fileID: 8300000, guid: 132b6615c562a1b4e8f83e86eda93463, type: 3}
