    onComplete:
      m_PersistentCalls:
        m_Calls: []
  - name: Pick the Phone
    instruction: "\u05E7\u05D9\u05D1\u05DC\u05EA\u05DD \u05D4\u05D5\u05D3\u05E2\u05EA
      \u05E1\u05DE\u05E1\n\u05D9\u05E9 \u05DC\u05DB\u05DD \u05D8\u05DC\u05E4\u05D5\u05DF
      \u05E2\u05DC \u05D4\u05E9\u05D5\u05DC\u05D7\u05DF - \u05D4\u05E8\u05D9\u05DE\u05D5
      \u05D0\u05D5\u05EA\u05D5, \u05DC\u05D7\u05E6\u05D5 \u05E2\u05DD \u05D4\u05D0\u05E6\u05D1\u05E2
      \u05DC\u05E4\u05EA\u05D9\u05D7\u05EA \u05D4\u05D4\u05D5\u05D3\u05E2\u05D4,
      \u05D5\u05D0\u05D6 \u05D4\u05D7\u05DC\u05D9\u05E7\u05D5 \u05D0\u05D5\u05EA\u05D4
      \u05D9\u05DE\u05D9\u05E0\u05D4 \u05DC\u05DE\u05D7\u05D9\u05E7\u05D4"
    voiceClip: {fileID: 8300000, guid: cc735cbcc23b7f845967f663df077e81, type: 3}
